rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ──────────────────────────────────────
    //  Helper functions
    // ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.admin == true;
    }

    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // ──────────────────────────────────────
    //  PUBLIC READ — All image folders
    //  gallery, backgrounds, aboutus, app-images, shop, splash, workers
    //  כל אחד יכול לקרוא תמונות (כולל אורח)
    //  רק אדמין יכול להעלות/למחוק
    // ──────────────────────────────────────
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageType() && isUnder10MB();
      allow delete: if isAdmin();
    }

    match /backgrounds/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageType() && isUnder10MB();
      allow delete: if isAdmin();
    }

    match /aboutus/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageType() && isUnder10MB();
      allow delete: if isAdmin();
    }

    match /app-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageType() && isUnder10MB();
      allow delete: if isAdmin();
    }

    match /shop/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageType() && isUnder10MB();
      allow delete: if isAdmin();
    }

    match /splash/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageType() && isUnder10MB();
      allow delete: if isAdmin();
    }

    match /workers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImageType() && isUnder10MB();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  User profile images
    //  כל משתמש מחובר יכול להעלות תמונת פרופיל שלו
    // ──────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && isImageType()
                   && isUnder10MB();
      allow delete: if isAuthenticated()
                    && (request.auth.uid == userId || isAdmin());
    }

    // ──────────────────────────────────────
    //  Default: deny everything else
    // ──────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
