rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────
    //  Helper functions
    // ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
          && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated()
          && request.auth.uid == userId;
    }

    // ──────────────────────────────────────
    //  PUBLIC READ — Gallery
    //  כל אחד (כולל אורח) יכול לקרוא גלריה
    // ──────────────────────────────────────
    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  PUBLIC READ — Settings (images, homeMessages, aboutUsText, popupMessage, aboutus)
    //  כל אחד (כולל אורח) יכול לקרוא הגדרות ציבוריות
    // ──────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Users
    // ──────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Appointments
    // ──────────────────────────────────────
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Barbers
    // ──────────────────────────────────────
    match /barbers/{barberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Treatments
    // ──────────────────────────────────────
    match /treatments/{treatmentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Waitlist
    // ──────────────────────────────────────
    match /waitlist/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ──────────────────────────────────────
    //  Admin Settings (notification settings etc.)
    // ──────────────────────────────────────
    match /adminSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Shop Items — כולם יכולים לקרוא, רק אדמין כותב
    // ──────────────────────────────────────
    match /shopItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Availability — כולם יכולים לקרוא (לצורך הזמנה), רק אדמין כותב
    // ──────────────────────────────────────
    match /availability/{availabilityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Daily Availability — כולם יכולים לקרוא (לצורך הזמנה), רק אדמין כותב
    // ──────────────────────────────────────
    match /dailyAvailability/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Notifications — כל משתמש קורא/מוחק/מעדכן את ההודעות שלו, אדמין יכול הכל
    // ──────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
                    && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated()
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ──────────────────────────────────────
    //  Push Tokens — רק אדמין (ניקוי בעת מחיקת משתמש)
    // ──────────────────────────────────────
    match /pushTokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    // ──────────────────────────────────────
    //  Scheduled Reminders — רק אדמין (ניקוי בעת מחיקת משתמש)
    // ──────────────────────────────────────
    match /scheduledReminders/{reminderId} {
      allow read, write: if isAdmin();
    }
  }
}
